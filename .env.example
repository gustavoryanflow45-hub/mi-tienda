APP_NAME=guStore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Panel de administración (config/admin.php). En XAMPP deja ADMIN_DOMAIN vacío
# y el panel cuelga de /ADMIN_PATH (por defecto /admin) en el mismo host. En producción, un host propio
# (admin.tudominio.com) con su propia cookie de sesión: nunca pongas
# SESSION_DOMAIN=.tudominio.com, compartiría la sesión de la tienda con
# subdominios. Tras cambiarlos: php artisan config:clear y php artisan route:clear
ADMIN_DOMAIN=
ADMIN_PATH=admin
ADMIN_ENFORCE_HOST=false
ADMIN_REQUIRE_2FA=true
# IPs o rangos CIDR que pueden abrir el panel, separados por comas. Vacío = todas.
# ADMIN_ALLOWED_IPS=203.0.113.7,10.0.0.0/8
ADMIN_ALLOWED_IPS=
# ADMIN_SESSION_COOKIE=gustore-admin-session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# En local se usa Mailtrap (sandbox.smtp.mailtrap.io:2525). En produccion,
# un proveedor transaccional con dominio propio. Nunca 'log' en produccion:
# la verificacion de correo dejaria de funcionar para los vendedores.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@gustore.test"
MAIL_FROM_NAME="guStore"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Pagos. Las credenciales DEBEN ser todas del mismo ambiente (test o live).
# STRIPE_WEBHOOK_SECRET lo da el dashboard al crear el endpoint; en local,
# `stripe listen --forward-to localhost:8000/webhooks/stripe` imprime el suyo.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# PayPhone (Ecuador): token y storeId de la aplicación creada en PayPhone
# Developer. Si es de prueba o real lo decide esa aplicación, no una variable.
# En producción el botón solo funciona en el dominio HTTPS registrado allí.
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=

# Push a las apps (FCM). JSON de la cuenta de servicio de Firebase: Configuración
# del proyecto -> Cuentas de servicio -> Generar clave privada. Guárdalo fuera de
# public/ y de git (storage/app/private/ ya está ignorado). Vacío = sin push.
# Los push salen por la cola: hace falta php artisan queue:work en marcha.
FCM_CREDENTIALS=
FCM_ENABLED=true
FCM_ANDROID_CHANNEL=general

# API móvil (config/api.php): vida de un token y sesiones por cuenta.
API_TOKEN_TTL_DAYS=30
API_MAX_DEVICES=10
# Billetera (config/wallet.php).
# Monto mínimo de un retiro, web y app. ¡FIJAR ANTES DE PRODUCCIÓN! El 1 por
# defecto solo mantiene lo que la web ya exigía.
WALLET_MIN_WITHDRAWAL=1
# Comisión de red de cada recarga y retiro pedidos desde la app (no la web):
# recarga de X acredita X - fee; retiro de X descuenta X y se transfieren X - fee.
WALLET_APP_NETWORK_FEE=1
# Esquema de la app al que vuelve un pago de PayPhone iniciado en ella.
API_APP_PAYMENT_RETURN_URL=mitienda://payment-result
